POSTGRES_PASSWORD=set_password_here

# El perfil ia incluye un mock funcional; no requiere credenciales de Gemini/OpenAI.
# Sobrescribir sólo si quieres utilizar otro endpoint compatible.
# AI_SERVICE_URL=http://host.docker.internal:8002/recommendations

# Simulaciones opcionales: demora entre 0 y 10 segundos; fallo none o unavailable.
MOCK_DELAY_SECONDS=0
MOCK_FAILURE_MODE=none
